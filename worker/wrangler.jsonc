{
  "name": "pos-api",
  "main": "src/index.js",
  // Must not exceed what the installed workers runtime supports, or
  // `wrangler dev` refuses to start. Bump this together with the wrangler
  // devDependency, never on its own.
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pos",
      // Created 2026-09-22 in the APAC region.
      "database_id": "66f8b8ee-7cf2-4f53-bf95-31c9565f988f"
    }
  ],

  // Item tile images. Create the bucket before deploying:
  //   npx wrangler r2 bucket create pos-images
  // `wrangler dev --local` simulates this on disk, so tests need no bucket.
  // The upload route returns 503 rather than crashing if the binding is absent,
  // so a deploy without the bucket degrades to a catalog with no photos.
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "pos-images"
    }
  ]
}
