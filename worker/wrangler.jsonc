{
  "name": "pos-api",
  "main": "src/index.js",
  // Must not exceed what the installed workers runtime supports, or
  // `wrangler dev` refuses to start. Bump this together with the wrangler
  // devDependency, never on its own.
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pos",
      // Filled in by `wrangler d1 create pos` — see worker/README.md
      "database_id": "PLACEHOLDER_RUN_D1_CREATE"
    }
  ]
}
