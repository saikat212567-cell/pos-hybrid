<?xml version="1.0" encoding="utf-8"?>
<!--
  Entry field at the top, catalog grid below, cart and totals pinned at the
  bottom.

  The entry field comes first because that is where the whole shift is spent: a
  barcode scanner is a keyboard that types into whatever has focus, and a counter
  typing a code should never have to reach for the field. Everything else is
  arranged around keeping it focused.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:textSize="12sp" />

    <!-- Code, barcode or name. inputType=text with no suggestions: autocorrect
         would mangle a scanned barcode. -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Code, barcode or name   (3*12 for three)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/entry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:textSize="20sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Catalog: image tiles, 3 across. The only workable path for the many
         items with no code. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/products"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1.2"
        android:contentDescription="Product catalog" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="6dp"
        android:background="?android:attr/listDivider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/cart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Cart" />

    <TextView
        android:id="@+id/breakdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#6B7280"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="4dp"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Payment mode and bill size, side by side so neither costs a row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/paymode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="Payment mode"
            android:minHeight="48dp" />

        <Spinner
            android:id="@+id/format"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="Bill format"
            android:minHeight="48dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/charge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:minHeight="52dp"
        android:text="Charge"
        android:textSize="17sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/print"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="Print bill" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/share"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:minHeight="48dp"
            android:text="Share / PDF" />
    </LinearLayout>
</LinearLayout>
